---
layout: layouts/base.njk
pagination:
  data: projects.items
  size: 1
  alias: project
permalink: "/projects/{{ project.slug }}/index.html"
eleventyComputed:
  title: "{{ project.title }}"
---
<section class="hero">
  <p class="badge">Project detail</p>
  <h1 class="brand-name">{{ project.title }}</h1>
  <p class="bio-text">{{ project.tagline }}</p>
  <div class="badge-row">
    <span class="badge">{{ project.year }}</span>
    <span class="badge status-{{ project.status }}">{{ project.status }}</span>
  </div>
</section>

<section class="split">
  <article class="panel">
    <h2 class="section-title">Problem</h2>
    <p class="bio-text">{{ project.problem }}</p>

    <h2 class="section-title">Approach</h2>
    <p class="bio-text">{{ project.approach }}</p>

    <h2 class="section-title">Outcome</h2>
    <p class="bio-text">{{ project.outcome }}</p>

    <h2 class="section-title">What Changed Me</h2>
    <p class="bio-text">{{ project.lessons }}</p>
  </article>

  <aside class="panel">
    <h2 class="section-title">Stack</h2>
    <div class="stack">
      {% for item in project.stack %}
        <span>{{ item }}</span>
      {% endfor %}
    </div>

    <h2 class="section-title">Links</h2>
    <ul class="mono-list">
      {% if project.links.repo %}<li><a href="{{ project.links.repo }}">Repository</a></li>{% endif %}
      {% if project.links.demo %}<li><a href="{{ project.links.demo }}">Demo / Download</a></li>{% endif %}
      {% if project.links.writeup %}<li><a href="{{ project.links.writeup }}">Write-up</a></li>{% endif %}
    </ul>
  </aside>
</section>
