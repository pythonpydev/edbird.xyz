  .theme-guide81-neon .vector-grid::before,
  .theme-guide81-neon .vector-grid::after {
    content: "";
    position: absolute;
    inset: 10% 8%;
    border: 1px solid rgba(0, 210, 255, 0.7);
    box-shadow: 0 0 8px rgba(0, 210, 255, 0.45);
    pointer-events: none;
    animation: neon-wire-breathe var(--wire-breathe-duration) ease-in-out infinite;
  }

  .theme-guide81-neon .vector-grid::after {
    inset: 28% 20%;
    border-color: rgba(255, 211, 0, 0.72);
    box-shadow: 0 0 8px rgba(255, 211, 0, 0.45);
    animation-delay: 0.7s;
  }

  @keyframes neon-title-pulse {
    0%,
    100% {
      text-shadow:
