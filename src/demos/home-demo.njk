  }

  .theme-soylent .card {
    border: 1px solid #455547;
    background: #182019;
  }

  .theme-soylent .tag {
    border: 1px solid #425346;
    border-radius: 0;
    background: #202a21;
  }

  .theme-soylent .theme-swatch {
    margin-top: 0.9rem;
  }

</style>
{% endif %}

{% if theme.slug == "hitchhikers-vector-neon-1981" %}
<style>
  .theme-guide81-neon {
