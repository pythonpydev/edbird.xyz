  }

  .theme-guide81-neon {
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .theme-guide81-neon .hero,
  .theme-guide81-neon .card,
  .theme-guide81-neon .panel {
