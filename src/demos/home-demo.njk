    letter-spacing: 0.14em;
  }

  .theme-soylent .ration-strip {
    margin-top: 0.78rem;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
  }

  .theme-soylent .ration-cell {
    border: 1px solid #4c5c4c;
    background: #1a241d;
    padding: 0.5rem;
