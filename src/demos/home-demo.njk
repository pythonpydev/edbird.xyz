    --grid-drift-duration: 8.5s;
    --wire-breathe-duration: 5.2s;
    --wire-opacity-min: 0.85;
    --wire-scale-max: 1.003;
  }

  .theme-guide81-neon.neon-broadcast {
    --frame-pulse-duration: 2.6s;
    --scanline-drift-duration: 4.4s;
