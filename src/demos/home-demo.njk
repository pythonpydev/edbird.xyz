---
layout: layouts/base.njk
pagination:
  data: themes.items
  size: 1
  alias: theme
permalink: "/demos/{{ theme.slug }}/index.html"
bodyClass: theme-demo
eleventyComputed:
  title: "Demo · {{ theme.name }}"
  description: "Theme demo for {{ theme.name }}"
---
<style>
  :root {
    --bg: {{ theme.palette.bg }};
    --surface: {{ theme.palette.surface }};
    --text: {{ theme.palette.text }};
    --muted: {{ theme.palette.muted }};
    --accent: {{ theme.palette.accent }};
    --accent-alt: {{ theme.palette.accentAlt }};
    --border: {{ theme.palette.border }};
  }
</style>

{% if theme.slug == "rollerball-1975" %}
<style>
  @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Orbitron:wght@600;700;800&family=Share+Tech+Mono&display=swap");

  .theme-rollerball {
    --bg: #0b0c10;
    --surface: #101319;
    --text: #f5f5f7;
    --muted: #c0c0c0;
    --accent: #ff5500;
    --accent-alt: #c0c0c0;
    --border: #c0c0c0;
    --font-display: "Orbitron", sans-serif;
    --font-mono: "Share Tech Mono", monospace;
    --font-body: "Inter", sans-serif;
  }

  .theme-rollerball {
    font-family: var(--font-body);
  }

  .theme-rollerball .backdrop-grid {
    opacity: 0.2;
    mask-image: none;
  }

  .theme-rollerball .hero,
  .theme-rollerball .card,
  .theme-rollerball .panel {
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    box-shadow: none;
  }

  .theme-rollerball h1,
  .theme-rollerball h2,
  .theme-rollerball h3 {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .theme-rollerball p,
  .theme-rollerball li,
  .theme-rollerball .tag,
  .theme-rollerball .badge {
    color: var(--text);
  }

  .theme-rollerball .theme-stats,
  .theme-rollerball .section-title,
  .theme-rollerball .badge {
    font-family: var(--font-mono);
  }

  .theme-rollerball a {
    color: var(--accent);
    text-decoration: none;
  }

  .theme-rollerball a:hover {
    color: var(--text);
    text-shadow: 0 0 8px rgba(255, 85, 0, 0.4);
  }

  .theme-rollerball .theme-action {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.45rem 0.8rem;
    border: 2px solid var(--accent);
    color: var(--text);
    background: #050608;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .theme-rollerball .theme-action:hover {
    box-shadow: 0 0 12px rgba(255, 85, 0, 0.45);
  }

  .theme-rollerball .status-active,
  .theme-rollerball .status-maintained,
  .theme-rollerball .status-archived {
    color: var(--accent);
  }

  .theme-rollerball .tag,
  .theme-rollerball .badge,
  .theme-rollerball .stack span {
    border: 1px solid var(--border);
    border-radius: 0;
    background: #0c0f14;
  }

  .theme-rollerball .rollerball-lockup {
    display: inline-block;
    border: 2px solid var(--border);
    padding: 0.75rem 1rem;
    margin-bottom: 0.8rem;
    background: #0c0f14;
  }

  .theme-rollerball .rollerball-masthead {
    margin: 0;
    color: var(--accent);
    font-size: clamp(2.2rem, 8vw, 4.8rem);
    line-height: 0.9;
  }

  .theme-rollerball .rollerball-subline {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: clamp(0.55rem, 1.3vw, 0.84rem);
  }

  .theme-rollerball .scoreboard-hero {
    margin-top: 1rem;
    border: 1px solid var(--border);
    background: #0a0d12;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    padding: 0.85rem;
  }

  .theme-rollerball .team-column,
  .theme-rollerball .clock-core,
  .theme-rollerball .period-strip,
  .theme-rollerball .numeric-strip {
    border: 1px solid var(--border);
    background: #0d1118;
  }

  .theme-rollerball .team-column {
    padding: 0.75rem;
  }

  .theme-rollerball .team-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.65rem;
  }

  .theme-rollerball .team-name {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    letter-spacing: 0.15em;
  }

  .theme-rollerball .team-score {
    font-family: var(--font-display);
    color: var(--accent);
    font-size: clamp(2rem, 6vw, 3.2rem);
    line-height: 1;
  }

  .theme-rollerball .numeric-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .theme-rollerball .numeric-strip span {
    padding: 0.32rem 0.2rem;
    border-right: 1px solid var(--border);
  }

  .theme-rollerball .numeric-strip span:last-child {
    border-right: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .theme-rollerball .center-column {
    display: grid;
    gap: 0.6rem;
  }

  .theme-rollerball .clock-core {
    position: relative;
    padding: 0.75rem;
    text-align: center;
  }

  .theme-rollerball .clock-label {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--muted);
    letter-spacing: 0.14em;
    font-size: 0.7rem;
  }

  .theme-rollerball .clock-time {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    color: #ffffff;
    letter-spacing: 0.1em;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    line-height: 1;
    animation: rollerball-clock-tick 1s steps(1, end) infinite;
  }

  .theme-rollerball .team-column.houston .team-name {
    color: var(--accent);
  }

  .theme-rollerball .team-column.madrid .team-name,
  .theme-rollerball .team-column.madrid .team-score,
  .theme-rollerball .team-column.madrid .numeric-strip span {
    color: #48ff6b;
  }

  .theme-rollerball .clock-core::after {
    content: "LIVE";
    position: absolute;
    top: 0.35rem;
    right: 0.4rem;
    border: 1px solid var(--accent);
    padding: 0.08rem 0.24rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    animation: rollerball-live-blink 1s steps(2, end) infinite;
  }

  .theme-rollerball .period-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .theme-rollerball .period-strip span {
    padding: 0.28rem 0.2rem;
    border-right: 1px solid var(--border);
    color: var(--muted);
  }

  .theme-rollerball .period-strip span:last-child {
    border-right: 0;
  }

  .theme-rollerball .period-strip .is-live {
    color: var(--text);
    background: rgba(255, 85, 0, 0.18);
    font-weight: 700;
    animation: rollerball-period-pulse 1s steps(2, end) infinite;
  }

  .theme-rollerball .scoreboard-hero.is-live .team-column.houston .team-score {
    animation: rollerball-score-pulse-orange 1.25s ease-in-out infinite;
  }

  .theme-rollerball .scoreboard-hero.is-live .team-column.madrid .team-score {
    animation: rollerball-score-pulse-green 1.25s ease-in-out infinite;
  }

  .theme-rollerball .team-column.score-flash {
    box-shadow: inset 0 0 22px rgba(255, 85, 0, 0.28);
  }

  @keyframes rollerball-clock-tick {
    0% {
      text-shadow: 0 0 0 rgba(255, 85, 0, 0);
      transform: translateY(0);
    }
    50% {
      text-shadow: 0 0 8px rgba(255, 85, 0, 0.45);
      transform: translateY(-1px);
    }
    100% {
      text-shadow: 0 0 0 rgba(255, 85, 0, 0);
      transform: translateY(0);
    }
  }

  @keyframes rollerball-live-blink {
    0% { opacity: 0.35; }
    50% { opacity: 1; }
    100% { opacity: 0.35; }
  }

  @keyframes rollerball-period-pulse {
    0% {
      background: rgba(255, 85, 0, 0.12);
      box-shadow: inset 0 0 0 rgba(255, 85, 0, 0);
    }
    50% {
      background: rgba(255, 85, 0, 0.28);
      box-shadow: inset 0 0 14px rgba(255, 85, 0, 0.3);
    }
    100% {
      background: rgba(255, 85, 0, 0.12);
      box-shadow: inset 0 0 0 rgba(255, 85, 0, 0);
    }
  }

  @keyframes rollerball-score-pulse-orange {
    0% {
      color: var(--accent);
      transform: scale(1);
      text-shadow: 0 0 0 rgba(255, 85, 0, 0);
    }
    50% {
      color: #ffd5bf;
      transform: scale(1.05);
      text-shadow: 0 0 14px rgba(255, 85, 0, 0.55);
    }
    100% {
      color: var(--accent);
      transform: scale(1);
      text-shadow: 0 0 0 rgba(255, 85, 0, 0);
    }
  }

  @keyframes rollerball-score-pulse-green {
    0% {
      color: #48ff6b;
      transform: scale(1);
      text-shadow: 0 0 0 rgba(72, 255, 107, 0);
    }
    50% {
      color: #b5ffc3;
      transform: scale(1.05);
      text-shadow: 0 0 14px rgba(72, 255, 107, 0.55);
    }
    100% {
      color: #48ff6b;
      transform: scale(1);
      text-shadow: 0 0 0 rgba(72, 255, 107, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-rollerball .clock-time,
    .theme-rollerball .clock-core::after,
    .theme-rollerball .period-strip .is-live,
    .theme-rollerball .scoreboard-hero.is-live .team-column.houston .team-score,
    .theme-rollerball .scoreboard-hero.is-live .team-column.madrid .team-score {
      animation: none;
    }
  }

  @media (min-width: 880px) {
    .theme-rollerball .scoreboard-hero {
      grid-template-columns: 1fr 0.84fr 1fr;
      align-items: stretch;
    }
  }
</style>
{% endif %}

{% if theme.slug == "soylent-green-1973" %}
<style>
  .theme-soylent {
