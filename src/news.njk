---
layout: layouts/base.njk
title: News
permalink: /news/index.html
---
<section class="hero">
  <h1 class="brand-name">News</h1>
  <p class="bio-text">Milestones and updates.</p>
</section>

<section class="grid">
  {% for milestone in milestones.items %}
    <article class="card span-4">
      <h2>{{ milestone.title }}</h2>
      <p class="meta-line"><strong>{{ milestone.date }}</strong></p>
      <p class="tagline">{{ milestone.summary }}</p>
      {% if milestone.link %}<p class="meta-line"><a href="{{ milestone.link }}">Related link</a></p>{% endif %}
    </article>
  {% endfor %}
</section>
