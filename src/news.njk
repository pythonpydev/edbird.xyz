---
layout: layouts/base.njk
title: News
permalink: /news/index.html
---
<section class="hero">
  <h1 class="brand-name">News</h1>
  <p class="bio-text">Milestones and updates.</p>
  <p class="meta-line"><a href="/feed.xml">Subscribe via RSS →</a></p>
</section>

<section class="grid">
  {% for milestone in milestones.items %}
    <article class="card span-4">
      <h2>{{ milestone.title }}</h2>
      <p class="meta-line"><strong>{{ milestone.date }}</strong></p>
      <p class="tagline">{{ milestone.summary }}</p>
      {% if milestone.tags.length %}
        <div class="tags">
          {% for tag in milestone.tags %}
            <a href="/tags/{{ tag | tagSlug }}/">{{ tag }}</a>
          {% endfor %}
        </div>
      {% endif %}
      {% if milestone.link %}<p class="meta-line"><a href="{{ milestone.link }}">View item</a></p>{% endif %}
    </article>
  {% endfor %}
</section>
