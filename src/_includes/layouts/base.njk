<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title | safe }} | {{ profile.name }}</title>
    <meta name="description" content="{{ (description or profile.bioShort) | safe }}" />
    <link rel="icon" type="image/png" href="/assets/cmd_prompt.png" />
    <link rel="alternate" type="application/rss+xml" title="{{ profile.name }} — Latest News" href="/feed.xml" />
    <link rel="apple-touch-icon" href="/assets/cmd_prompt.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ title | safe }} | {{ profile.name }}" />
    <meta property="og:description" content="{{ (description or profile.bioShort) | safe }}" />
    <meta property="og:image" content="https://edbird.xyz/assets/cmd_prompt.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{ title | safe }} | {{ profile.name }}" />
    <meta name="twitter:description" content="{{ (description or profile.bioShort) | safe }}" />
    <meta name="twitter:image" content="https://edbird.xyz/assets/cmd_prompt.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600;700&family=VT323&display=swap"
    />
    <link rel="stylesheet" href="/assets/styles.css" />
    <script>
      (function () {
        var stored = localStorage.getItem("theme");
        if (stored === "dark") {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body class="{{ bodyClass or '' }}">
    <header class="site-header frame">
      <a class="brand" href="/"><img src="/assets/cmd_prompt.png" alt="{{ profile.name }}" class="brand-icon" /></a>
      <nav>
        <ul class="nav-list">
          <li><a href="/">Home</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/projects/">Projects</a></li>
          <li><a href="/websites/">Websites</a></li>
          <li><a href="/news/">News</a></li>
          <li><a href="/education/">Education</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <span class="theme-toggle-icon" aria-hidden="true">◐</span>
      </button>
    </header>

    <main class="frame">
      {{ content | safe }}
    </main>

    <footer class="site-footer frame">
      <p>{{ profile.name }} · {{ profile.role }}</p>
      <ul class="footer-links">
        <li>
          <a href="https://buymeacoffee.com/pydev1" aria-label="Buy me a coffee">
            <img src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png" alt="Buy Me a Coffee" width="120" height="33" style="display:block; height:auto; width:120px;" />
          </a>
        </li>
      </ul>
    </footer>

    <script>
      (function () {
        var toggle = document.getElementById("theme-toggle");
        var root = document.documentElement;

        function isDark() {
          return root.getAttribute("data-theme") === "dark";
        }

        toggle.setAttribute("aria-pressed", String(isDark()));

        toggle.addEventListener("click", function () {
          if (isDark()) {
            root.removeAttribute("data-theme");
            localStorage.setItem("theme", "light");
          } else {
            root.setAttribute("data-theme", "dark");
            localStorage.setItem("theme", "dark");
          }
          toggle.setAttribute("aria-pressed", String(isDark()));
        });
      })();
    </script>
  </body>
</html>
